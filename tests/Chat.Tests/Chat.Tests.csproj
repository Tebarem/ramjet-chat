<Project Sdk="Microsoft.NET.Sdk">
  <!-- Out-of-server tests for the pure core of src/: templates, the markup gate, mentions, filters, limits, durations, the ignore relation,
       the log line and the config. Engine-facing files are not compiled here. No NuGet packages, no engine build needed. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RootNamespace>RamjetChat.Tests</RootNamespace>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="*.cs" />
    <Compile Include="../../src/Core/**/*.cs" />
    <Compile Include="../../src/Config/ChatConfig.cs" />
  </ItemGroup>
</Project>
